                "file_path": "kv.py",
                "content": "import threading\n\nclass ThreadSafeKV:\n    def __init__(self):\n        self._data = {}\n        self._lock = threading.RLock()\n    def get(self, key, default=None):\n        with self._lock: return self._data.get(key, default)\n    def set(self, key, val):\n        with self._lock: self._data[key] = val\n    def delete(self, key):\n        with self._lock: self._data.pop(key, None)\n"
