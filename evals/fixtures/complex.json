          "tool_calls": [
            {
              "name": "write_file",
              "args": {
                "file_path": "toposort.py",
                "content": "class CycleError(Exception): pass\n\ndef topological_sort(graph: dict[str, list[str]]) -> list[str]:\n    visited, visiting, result = set(), set(), []\n    def dfs(node):\n        if node in visiting: raise CycleError('Cycle detected')\n        if node in visited: return\n        visiting.add(node)\n        for dep in graph.get(node, []):\n            dfs(dep)\n        visiting.remove(node)\n        visited.add(node)\n        result.append(node)\n    for n in graph: dfs(n)\n    return result\n"
              },
