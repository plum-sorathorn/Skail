                "file_path": "atomic_io.py",
                "content": "import os, tempfile\nfrom pathlib import Path\n\ndef atomic_write(target_path: str, content: str):\n    p = Path(target_path)\n    p.parent.mkdir(parents=True, exist_ok=True)\n    with tempfile.NamedTemporaryFile('w', dir=p.parent, delete=False, encoding='utf-8') as tmp:\n        tmp.write(content)\n        tmp.flush()\n        os.fsync(tmp.fileno())\n        tmp_name = tmp.name\n    os.replace(tmp_name, p)\n"
